{
  "name": "meeting-whiteboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An agent that listens to a technical meeting and keeps a design doc and architecture diagram current as decisions change.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch src/server.ts\" \"vite --config web/vite.config.ts\"",
    "build": "vite build --config web/vite.config.ts",
    "start": "pnpm build && tsx src/server.ts",
    "replay": "tsx src/cli.ts",
    "eval": "tsx src/eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "live:demo": "tsx scripts/live-audio-demo.ts",
    "recall:sim": "tsx scripts/recall-simulator.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/openai": "4.0.122",
    "@anthropic-ai/sdk": "1.12.0",
    "@hono/node-server": "2.1.11",
    "ai": "7.0.179",
    "dotenv": "^18.0.10",
    "hono": "4.13.20",
    "ws": "^8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "marked": "18.2.1",
    "mermaid": "12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
