# At least one model key. Anthropic is the default provider.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...           # for openai/* models and live audio transcription

# Models: "<provider>/<model>"
# MODEL=anthropic/claude-sonnet-5-5    # scribe; e.g. anthropic/claude-opus-5-5, openai/gpt-6-luna
# EFFORT=medium                        # low | medium | high
# EDITOR_MODEL=                        # diagram + summary; defaults to MODEL
# EDITOR_EFFORT=medium
# JUDGE_MODEL=anthropic/claude-sonnet-5-5   # eval judge
# PORT=8787

# --- Live audio (browser mic / meeting tab) -> OpenAI realtime transcription (needs OPENAI_API_KEY) ---
# TRANSCRIBE_MODEL=gpt-4o-transcribe   # or gpt-4o-mini-transcribe (cheaper), gpt-live-transcribe (local VAD)
# TRANSCRIBE_LANGUAGE=en

# --- Meeting bot: which provider sends the bot (default: whichever has a key, Recall first) ---
# BOT_PROVIDER=recall             # recall | attendee

# --- Meeting bot (Recall.ai) joins Zoom / Google Meet / Teams and streams named speakers ---
# RECALL_API_KEY=...              # from https://<region>.recall.ai/dashboard/developers/api-keys
# RECALL_REGION=us-east-1         # us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1 (must match the key)
# RECALL_WEBHOOK_SECRET=whsec_... # optional: also verify Recall's webhook signatures
# Recall must reach this server. Either set PUBLIC_URL to a tunnel / deployment, e.g.
#   cloudflared tunnel --url http://localhost:8787   -> PUBLIC_URL=https://<name>.trycloudflare.com
# or leave it unset: if cloudflared is installed, a quick tunnel starts automatically.
# PUBLIC_URL=
# AUTO_TUNNEL=0                   # disable the automatic cloudflared tunnel

# --- Meeting bot (self-hosted Attendee, docs/live-sources.md) ---
# ATTENDEE_API_KEY=...            # Attendee UI -> API Keys
# ATTENDEE_BASE_URL=http://localhost:8000
# ATTENDEE_TRANSCRIPTION=captions # captions (free, from the meeting platform) | deepgram (key stored in Attendee's Settings)
# ATTENDEE_LANGUAGE=en-US         # optional caption language
# ATTENDEE_WEBHOOK_SECRET=...     # optional: Attendee UI -> Settings -> Webhooks; also verify X-Webhook-Signature
# ATTENDEE_WEBHOOK_BASE_URL=      # optional: where Attendee posts webhooks instead of PUBLIC_URL / the tunnel
